# Local-only configuration. In production these live in each script's
# Script Properties (Apps Script editor → Project Settings → Script Properties),
# which is what `getEnv()` reads at runtime. See libs/shared/get-env.ts.
#
# Copy to `.env` — it is git-ignored.

# ---------------------------------------------------------------------------
# Deployment ids (web apps / API executables)
# ---------------------------------------------------------------------------
# These normally live in `deployments.json`, committed with the code — a
# deployment id is the public part of the web app URL, not a credential.
# Nothing to set here.
#
# The forms below only override that file for a one-off deploy (they win over
# it). One variable per app, named after the app folder, upper-cased,
# non-alphanumerics as `_`:
#   apps/my-web-app -> MY_WEB_APP_DEPLOYMENT_ID
#
# MY_WEB_APP_DEPLOYMENT_ID=AKfycb...
#
# Single-variable form, also usable as a CI secret:
# CLASP_DEPLOYMENTS={"my-web-app":"AKfycb..."}

# ---------------------------------------------------------------------------
# Your own app config
# ---------------------------------------------------------------------------
# TEST=true
